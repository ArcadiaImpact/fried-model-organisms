# Copy to .env (gitignored) and fill in the keys you need. Both CLIs auto-load .env from the
# current working directory.

# OpenAI / OpenAI-compatible endpoints (the `openai` metric backend, the eval-suite endpoint
# client, and the safety judge). For a self-served vLLM endpoint any non-empty value works.
OPENAI_API_KEY=

# Anthropic (the `anthropic` metric backend). Note: the SDK reads ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=

# HuggingFace token. Needed for: gated models (e.g. Llama) on the `local` backend, pulling
# hosted item lists / eval datasets, and the optional `--upload-hf` results upload.
HF_TOKEN=

# Optional: point the bare-name dataset resolver (items_500, items_2000, ...) at your own
# hosted dataset repo instead of the public default.
# MU_DATASET_REPO=youruser/your-item-lists
